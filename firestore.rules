rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função utilitária para verificar se o usuário está autenticado no Firebase (Google)
    function isSignedIn() {
      return request.auth != null;
    }

    // =========================================================================
    // Coleção: /users/{userId}
    // Permite que qualquer usuário autenticado com Google acesse e crie seu perfil
    // =========================================================================
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================================
    // Coleção: /admins/{userId}
    // =========================================================================
    match /admins/{userId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================================
    // Coleção: /demandas/{demandaId}
    // Espaço compartilhado da equipe: qualquer usuário autenticado pode
    // visualizar, criar, atualizar prazos e concluir demandas em tempo real
    // =========================================================================
    match /demandas/{demandaId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================================
    // Fallback de segurança para todas as outras coleções
    // =========================================================================
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
